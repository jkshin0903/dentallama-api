# 선택할 모델 타입 (llavanext 또는 gemma)
MODEL_TYPE=

# 별도로 저장해 둔 LlavaNext tokenizer 경로 (없으면 processor 내부 토크나이저 사용)
# LoRA/PEFT 어댑터 가중치 경로

# Gemma 멀티모달 모델 본체 경로
GEMMA_MODEL_PATH=
# Gemma Processor/AutoProcessor.from_pretrained 경로
GEMMA_PROCESSOR_PATH=
# Gemma tokenizer 경로 (없으면 processor 내부 토크나이저 사용)
GEMMA_TOKENIZER_PATH=
# Gemma용 LoRA/PEFT 어댑터 가중치 경로
GEMMA_PEFT_ADAPTER_PATH=
# Gemma 모델 로딩 시 4bit 양자화 여부
GEMMA_LOAD_IN_4BIT=

# RAG에서 사용할 BGE-M3 임베딩 모델 경로
RAG_EMBED_MODEL_PATH=
# Milvus 연결 정보 (RAG 인덱스)
MILVUS_HOST=
MILVUS_PORT=
MILVUS_TOKEN=
# 요청 payload가 use_rag를 생략했을 때 기본값
USE_RAG_DEFAULT=
