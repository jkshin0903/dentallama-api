# 선택할 모델 타입 (llavanext 또는 gemma)
MODEL_TYPE=

# 별도로 저장해 둔 LlavaNext tokenizer 경로 (없으면 processor 내부 토크나이저 사용)
# LoRA/PEFT 어댑터 가중치 경로

# Gemma 멀티모달 모델 본체 경로
GEMMA_MODEL_PATH=
# Gemma Processor/AutoProcessor.from_pretrained 경로
GEMMA_PROCESSOR_PATH=
# Gemma tokenizer 경로 (없으면 processor 내부 토크나이저 사용)
GEMMA_TOKENIZER_PATH=
# Gemma용 LoRA/PEFT 어댑터 가중치 경로
GEMMA_PEFT_ADAPTER_PATH=
# Gemma 모델 로딩 시 4bit 양자화 여부
GEMMA_LOAD_IN_4BIT=

# RAG에서 사용할 BGE-M3 임베딩 모델 경로
RAG_EMBED_MODEL_PATH=
# Milvus 연결 정보 (RAG 인덱스)
MILVUS_HOST=
MILVUS_PORT=
MILVUS_TOKEN=
# 요청 payload가 use_rag를 생략했을 때 기본값
USE_RAG_DEFAULT=

# OrthoPlanner (POST /api/v1/orthoplanner/treatment-plan)
# 경로는 models/orthoplanner/ 기준 상대경로 또는 절대경로
ORTHOPLANNER_ROOT=
ORTHOPLANNER_CKPT=fold0/best
ORTHOPLANNER_LLM_PATH=Llama_3.1_8B-Instruct
ORTHOPLANNER_CONFIG=config.yaml
# CUDA_VISIBLE_DEVICES 안에서 쓸 인덱스 (main.py가 GPU를 이미 고정한 경우 0)
ORTHOPLANNER_CUDA=0
# true면 서버 기동 시 가중치 로드 (Llama 로딩으로 수분 소요)
ORTHOPLANNER_PRELOAD=false
